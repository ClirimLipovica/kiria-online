# Kopiere diese Datei nach youtube/.env und trage deine Keys ein.
# ElevenLabs: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Google AI Studio (Nano Banana = Gemini Bild-Modell): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
